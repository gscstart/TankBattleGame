# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# === 虚拟环境 / 环境变量 ===
.venv/
venv/
.env

# === 编辑器 / IDE ===
.vscode/
.idea/
*.swp
*.swo

# === 操作系统 ===
.DS_Store
Thumbs.db

# === 测试产物（脚本式测试生成的截图，统一收在 tests/screenshots/） ===
tests/screenshots/
*.log

# === pytest 缓存 ===
.pytest_cache/

# === 用户运行时数据（排行榜等） ===
data/*.json
!data/.gitkeep

# === AI 助手本地缓存（oh-my-claudecode 插件状态：会话回放/HUD/任务状态/节流等，机器本地、环境相关，不入库） ===
.omc/

# === Review 工具（_ 前缀表示一次性 review 脚本，不入库） ===
tools/_*.py

# === 本地清理暂存（删除前先 mv 到这里，留 30 天确认再清） ===
.trash/
